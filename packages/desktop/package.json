{
  "name": "@lambda128/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "lambda128 — AI-powered coding assistant with agentic editing, chat, and tab autocomplete",
  "author": {
    "name": "lambda128",
    "email": "lambda128@proton.me"
  },
  "homepage": "https://github.com/androvonx95/lambda128",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');const p=require('path');const d='dist/renderer';fs.mkdirSync(d,{recursive:true});fs.cpSync('src/renderer',d,{recursive:true})\"",
    "package": "electron-builder --linux AppImage deb --win nsis --mac dmg",
    "package:linux": "electron-builder --linux AppImage deb",
    "package:win": "electron-builder --win nsis",
    "package:mac": "electron-builder --mac dmg"
  },
  "dependencies": {
    "@lambda128/vscode-extension": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0",
    "typescript": "^5.5.0"
  },
  "build": {
    "appId": "com.lambda128.app",
    "productName": "lambda128",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}.${ext}"
    }
  }
}