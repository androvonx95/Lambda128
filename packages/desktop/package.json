{
  "name": "@lambda128/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc",
    "package": "electron-builder"
  },
  "dependencies": {
    "@lambda128/vscode-extension": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.5.0"
  },
  "build": {
    "appId": "com.lambda128.app",
    "productName": "lambda128",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "node_modules/**/*"],
    "linux": { "target": ["AppImage", "deb"], "category": "Development" },
    "mac": { "target": ["dmg"], "category": "public.app-category.developer-tools" },
    "win": { "target": ["nsis"] }
  }
}